NODE_ENV=production
PORT=3000
APP_BASE_URL=https://atg.example.com

# Use "local" for development filesystem storage or "azure" for Cosmos DB + Blob Storage.
ATG_STORAGE_BACKEND=local

# Runtime storage roots for local filesystem-backed development.
ATG_DATA_ROOT=/var/lib/atg
ATG_STATE_ROOT=/var/lib/atg/.atg
ATG_PROJECTS_ROOT=/var/lib/atg/projects

# Azure deployment defaults.
AZURE_LOCATION=westus
AZURE_MIN_REPLICAS=0
AZURE_MAX_REPLICAS=1
# Set AZURE_MIN_REPLICAS=1 later if you want a warm instance and faster first-load response times.
CUSTOM_DOMAIN_NAME=tv.example.com
CUSTOM_DOMAIN_CERTIFICATE_ID=/subscriptions/00000000-0000-0000-0000-000000000000/resourceGroups/atg-prod-rg/providers/Microsoft.App/managedEnvironments/atg-prod-env/managedCertificates/example-cert
AZURE_COSMOS_ENDPOINT=https://atg-cosmos.documents.azure.com:443/
AZURE_COSMOS_DATABASE=atg
AZURE_COSMOS_PROJECTS_CONTAINER=projects
AZURE_COSMOS_USER_SETTINGS_CONTAINER=user-settings
AZURE_COSMOS_CODEX_JOBS_CONTAINER=codex-jobs
AZURE_COSMOS_AI_USAGE_CONTAINER=ai-usage-budget
AZURE_COSMOS_KEY=change-me
AZURE_STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=https;AccountName=change-me;AccountKey=change-me;EndpointSuffix=core.windows.net
AZURE_STORAGE_GAME_ASSETS_CONTAINER=game-assets
ENTRA_TENANT_ID=00000000-0000-0000-0000-000000000000
ENTRA_CLIENT_ID=00000000-0000-0000-0000-000000000000
ENTRA_CLIENT_SECRET=change-me

# Optional machine-to-machine API auth for CI, smoke tests, and trusted automation.
# Tokens should be issued for this API audience, usually api://<ENTRA_CLIENT_ID>.
ENTRA_API_AUDIENCE=api://00000000-0000-0000-0000-000000000000
# Comma-separated service principal application/client ids allowed to call editor APIs.
ENTRA_ALLOWED_APP_IDS=00000000-0000-0000-0000-000000000000

# ATG-managed AI closed-beta billing mode.
ATG_MANAGED_AI_ENABLED=false
ATG_MANAGED_OPENAI_API_KEY=sk-change-me
ATG_MANAGED_AI_MONTHLY_CREDIT_USD=5
ATG_MANAGED_AI_RESERVATION_USD=0.25

# Server-side Codex SDK endpoint at /api/chat/codex-sdk.
ENABLE_CODEX_SDK_PROTOTYPE=false
ATG_CODEX_SDK_WORKSPACE_ROOT=/tmp/atg-codex-sdk
ATG_CODEX_SDK_TIMEOUT_MS=300000
# ATG_CODEX_SDK_MODEL=
# Generate with: openssl rand -base64 32
ATG_USER_SETTINGS_ENCRYPTION_KEY=change-me

# Populated by Bicep for production isolated Container Apps Job execution.
AZURE_SUBSCRIPTION_ID=00000000-0000-0000-0000-000000000000
AZURE_RESOURCE_GROUP=atg-prod-rg
ATG_CODEX_JOB_NAME=atg-prod-codex-job
ATG_CODEX_JOB_IMAGE=ghcr.io/cornelison-cody/atg:latest

NODE_ENV=production
PORT=3000
APP_BASE_URL=https://atg.example.com

# Runtime storage roots for the current filesystem-backed implementation.
ATG_DATA_ROOT=/var/lib/atg
ATG_STATE_ROOT=/var/lib/atg/.atg
ATG_PROJECTS_ROOT=/var/lib/atg/projects

# Future durable persistence targets.
DATABASE_URL=postgres://atg:change-me@postgres:5432/atg
OBJECT_STORAGE_ENDPOINT=https://s3.example.com
OBJECT_STORAGE_BUCKET=atg-game-files
OBJECT_STORAGE_REGION=us-east-1
OBJECT_STORAGE_ACCESS_KEY_ID=change-me
OBJECT_STORAGE_SECRET_ACCESS_KEY=change-me

# Hosted game-editing worker.
AI_WORKER_URL=https://worker.example.com
AI_WORKER_TOKEN=change-me
OPENAI_API_KEY=sk-change-me

# Development-only escape hatch. Keep false/unset in production.
ENABLE_LOCAL_CODEX=false

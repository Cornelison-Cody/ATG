NODE_ENV=production
PORT=3000
APP_BASE_URL=https://atg.example.com

# Use "local" for development filesystem storage or "azure" for Cosmos DB + Blob Storage.
ATG_STORAGE_BACKEND=local

# Runtime storage roots for local filesystem-backed development.
ATG_DATA_ROOT=/var/lib/atg
ATG_STATE_ROOT=/var/lib/atg/.atg
ATG_PROJECTS_ROOT=/var/lib/atg/projects

# Azure deployment defaults.
AZURE_LOCATION=westus
AZURE_COSMOS_ENDPOINT=https://atg-cosmos.documents.azure.com:443/
AZURE_COSMOS_DATABASE=atg
AZURE_COSMOS_PROJECTS_CONTAINER=projects
AZURE_COSMOS_KEY=change-me
AZURE_STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=https;AccountName=change-me;AccountKey=change-me;EndpointSuffix=core.windows.net
AZURE_STORAGE_GAME_ASSETS_CONTAINER=game-assets
ENTRA_TENANT_ID=00000000-0000-0000-0000-000000000000
ENTRA_CLIENT_ID=00000000-0000-0000-0000-000000000000
ENTRA_CLIENT_SECRET=change-me

# Hosted game-editing worker.
AI_WORKER_URL=https://worker.example.com
AI_WORKER_TOKEN=change-me
OPENAI_API_KEY=sk-change-me

# Development-only escape hatch. Keep false/unset in production.
ENABLE_LOCAL_CODEX=false
